{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge Entry",
  "type": "object",
  "required": ["id", "title", "knowledge_type", "status", "evidence_level", "source_refs", "distilled_rule", "validation_cases", "review"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 3},
    "knowledge_type": {"enum": ["template", "expression", "argument", "diagnostic", "workflow"]},
    "status": {"enum": ["draft", "reviewing", "verified", "archived"]},
    "evidence_level": {"enum": ["source-backed", "partially-validated", "validated", "inferred"]},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "tags": {"type": "array", "items": {"type": "string"}},
    "original_observation": {"type": "string"},
    "ai_analysis": {"type": "string"},
    "distilled_rule": {"type": "string", "minLength": 10},
    "teaching_use": {"type": "string"},
    "template": {"type": "string"},
    "interpretation": {"type": "string"},
    "validation_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_id", "result"],
        "properties": {
          "case_id": {"type": "string"},
          "result": {"enum": ["pending", "pass", "revise", "fail"]},
          "note": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "conflicts": {"type": "array", "items": {"type": "string"}},
    "review": {
      "type": "object",
      "required": ["owner", "last_reviewed", "next_action"],
      "properties": {
        "owner": {"type": "string"},
        "last_reviewed": {"type": "string"},
        "reviewers": {"type": "array", "items": {"type": "string"}},
        "next_action": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
